---
import Decide from "../components/tools/ai-subscription/Decide.svelte";
import { LAST_CHECKED } from "../components/tools/ai-subscription/flow";
import { PLANS } from "../components/tools/ai-subscription/plans";
import ToolLayout from "../layouts/ToolLayout.astro";
---

<ToolLayout
  title="What $20 AI subscription should I buy?"
  description="Tons of people ask me this, in person and online, so here is my answer."
>
  <Decide client:idle />

  <section class="plans">
    <h2>All five, briefly</h2>
    <ul>
      {
        PLANS.map((plan) => (
          <li>
            <a href={plan.url} target="_blank" rel="noopener noreferrer">
              {plan.name}
            </a>
            <span class="plan-price">{plan.price}</span>
            <span class="plan-line">{plan.headline}</span>
          </li>
        ))
      }
    </ul>
    <p class="updated">Checked {LAST_CHECKED}.</p>
  </section>
</ToolLayout>

<style>
  .plans {
    margin-top: 3rem;
  }

  h2 {
    margin: 0 0 1rem;
    font-family: var(--font-family-serif);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--heading-color);
  }

  .plans ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .plans li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.6rem;
    align-items: baseline;
    padding: 0.6rem 0;
    border-top: 1px solid var(--border-color);
    font-size: 0.94rem;
    line-height: 1.45;
  }

  .plans li:first-child {
    border-top: 0;
  }

  .plans a {
    font-weight: 600;
  }

  .plan-price {
    color: var(--gray-color);
    font-variant-numeric: tabular-nums;
  }

  .plan-line {
    flex: 1 1 18rem;
    color: var(--gray-color);
  }

  .updated {
    margin: 1.25rem 0 0;
    color: var(--gray-color);
    font-size: 0.85rem;
  }
</style>
