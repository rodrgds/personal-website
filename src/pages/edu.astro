<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta
      name="theme-color"
      content="#fffcf0"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#100f0f"
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="description"
      content="An evolving research map on why higher education falls short, what universities actually do, and what better learning systems could look like."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://rgo.pt/edu" />
    <meta
      property="og:title"
      content="rgo.pt/edu: A research map on higher education"
    />
    <meta
      property="og:description"
      content="An evolving research map on why higher education falls short, what universities actually do, and what better learning systems could look like."
    />
    <title>rgo.pt/edu: A research map on higher education</title>
    <link rel="canonical" href="https://rgo.pt/edu" />
    <link rel="icon" href="/edu/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/edu/main-styles.css" />
    <script is:inline defer src="/edu/webpage.js"></script>
    <script
      defer
      src="https://cool.rgo.pt/script.js"
      data-website-id="01ab2edc-295f-49be-847c-c5d864a59106"
      data-domains="rgo.pt"
      is:inline></script>
  </head>
  <body>
    <a class="skip-link" href="#reader-list">Skip to the reading view</a>

    <main class="app" aria-busy="true">
      <header class="topbar">
        <a class="brand" href="/edu" aria-label="rgo.pt/edu, home">
          <span aria-hidden="true">rgo.pt/edu</span>
        </a>

        <p class="topbar-context">Higher education and what could come next</p>

        <div class="topbar-actions">
          <button class="text-button" type="button" data-action="start"
            >Start here</button
          >
          <button
            class="icon-button"
            type="button"
            data-action="reader"
            aria-label="Open reading view"
            title="Reading view"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24"
              ><path d="M4 5h16M4 9h16M4 13h10M4 17h13"></path></svg
            >
          </button>
          <button
            class="icon-button"
            type="button"
            data-action="theme"
            aria-label="Switch color theme"
            title="Switch color theme"
          >
            <svg class="theme-icon-light" aria-hidden="true" viewBox="0 0 24 24"
              ><circle cx="12" cy="12" r="4"></circle><path
                d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"
              ></path></svg
            >
            <svg class="theme-icon-dark" aria-hidden="true" viewBox="0 0 24 24"
              ><path
                d="M20.2 15.2A8.4 8.4 0 0 1 8.8 3.8 8.4 8.4 0 1 0 20.2 15.2Z"
              ></path></svg
            >
          </button>
          <button
            class="icon-button"
            type="button"
            data-action="help"
            aria-label="Show navigation help"
            title="Navigation help"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24"
              ><circle cx="12" cy="12" r="9"></circle><path
                d="M9.8 9a2.35 2.35 0 1 1 3.63 1.97c-.85.54-1.43 1.04-1.43 2.03M12 17h.01"
              ></path></svg
            >
          </button>
        </div>
      </header>

      <section class="canvas-shell" aria-label="Interactive idea map">
        <div
          id="canvas-viewport"
          class="canvas-viewport"
          tabindex="0"
          role="application"
          aria-label="Interactive canvas. Drag to pan, use Control or Command and scroll to zoom, or use the controls."
        >
          <div id="canvas-world" class="canvas-world">
            <svg id="canvas-edges" class="canvas-edges" aria-hidden="true"
            ></svg>
            <div id="canvas-nodes" class="canvas-nodes"></div>
          </div>

          <div class="loading-state" role="status">
            <span class="loading-mark" aria-hidden="true"></span>
            <span>Opening the map…</span>
          </div>

          <div class="canvas-hint" aria-hidden="true">
            <span>Drag to move</span>
            <span>Scroll to pan</span>
            <span><kbd>⌘</kbd> / <kbd>Ctrl</kbd> + scroll to zoom</span>
          </div>

          <nav class="canvas-controls" aria-label="Canvas controls">
            <button
              type="button"
              data-action="zoom-out"
              aria-label="Zoom out"
              title="Zoom out"
            >
              <svg aria-hidden="true" viewBox="0 0 24 24"
                ><path d="M5 12h14"></path></svg
              >
            </button>
            <output id="zoom-level" aria-label="Current zoom">100%</output>
            <button
              type="button"
              data-action="zoom-in"
              aria-label="Zoom in"
              title="Zoom in"
            >
              <svg aria-hidden="true" viewBox="0 0 24 24"
                ><path d="M12 5v14M5 12h14"></path></svg
              >
            </button>
            <span class="control-divider" aria-hidden="true"></span>
            <button
              type="button"
              data-action="fit"
              aria-label="Fit entire map"
              title="Fit entire map"
            >
              <svg aria-hidden="true" viewBox="0 0 24 24"
                ><path d="M8 3H3v5M16 3h5v5M21 16v5h-5M3 16v5h5"></path></svg
              >
            </button>
            <button
              type="button"
              data-action="locate"
              aria-label="Return to start"
              title="Return to start"
            >
              <svg aria-hidden="true" viewBox="0 0 24 24"
                ><circle cx="12" cy="12" r="3"></circle><circle
                  cx="12"
                  cy="12"
                  r="8"></circle></svg
              >
            </button>
          </nav>

          <button
            id="minimap"
            class="minimap"
            type="button"
            aria-label="Map overview. Drag or tap to move around the canvas. Press Enter to fit the entire map."
          >
            <svg id="minimap-svg" aria-hidden="true"></svg>
          </button>
        </div>
      </section>
    </main>

    <dialog id="reader-dialog" class="panel-dialog">
      <div class="panel-shell">
        <header class="panel-header">
          <div>
            <h1>Read the map</h1>
            <p>
              Every idea in thematic order. Pick one to return to its place.
            </p>
          </div>
          <button
            class="icon-button"
            type="button"
            data-close
            aria-label="Close reading view"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24"
              ><path d="m6 6 12 12M18 6 6 18"></path></svg
            >
          </button>
        </header>
        <label class="reader-search">
          <svg aria-hidden="true" viewBox="0 0 24 24"
            ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"
            ></path></svg
          >
          <span class="sr-only">Search the canvas</span>
          <input
            id="reader-search"
            type="search"
            placeholder="Search ideas and sources…"
            autocomplete="off"
          />
        </label>
        <p id="reader-count" class="reader-count" aria-live="polite"></p>
        <ol id="reader-list" class="reader-list" tabindex="-1"></ol>
      </div>
    </dialog>

    <dialog id="help-dialog" class="compact-dialog">
      <form method="dialog">
        <header>
          <h1>Move around the map</h1>
          <button
            class="icon-button"
            value="close"
            aria-label="Close navigation help"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24"
              ><path d="m6 6 12 12M18 6 6 18"></path></svg
            >
          </button>
        </header>
        <dl class="shortcut-list">
          <div><dt>Pan</dt><dd>Drag, scroll, or use arrow keys</dd></div>
          <div>
            <dt>Zoom</dt><dd>Pinch or <kbd>⌘</kbd>/<kbd>Ctrl</kbd> + scroll</dd>
          </div>
          <div><dt>Open an idea</dt><dd>Double-click a node</dd></div>
          <div><dt>Overview</dt><dd>Press <kbd>0</kbd></dd></div>
          <div><dt>Return to start</dt><dd>Press <kbd>Home</kbd></dd></div>
        </dl>
        <p class="help-note">
          External media is never required to understand the map. Every source
          keeps a direct-link fallback.
        </p>
      </form>
    </dialog>

    <div id="live-status" class="sr-only" aria-live="polite"></div>
    <noscript>
      <div class="noscript-message">
        This map needs JavaScript for panning and zooming. You can still <a
          href="/edu/main.canvas">download the open JSON Canvas source</a
        >.
      </div>
    </noscript>
  </body>
</html>
