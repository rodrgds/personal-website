---
import BaseHead from "../components/common/BaseHead.astro";
import Header from "../components/common/Header.astro";
import Footer from "../components/common/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";
import { getCollection } from "astro:content";
import { SOCIALS } from "../data/socials";
import Logo from "../components/common/Logo.astro";
import DateOfBirth from "../components/features/home/date-of-birth.svelte";
import GitHubContributions from "../components/features/home/GitHubContributions.svelte";

const posts = await getCollection("blog", ({ data }) => !data.draft).then(
  (posts) =>
    posts.sort((a, b) => {
      return (
        new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
      );
    }),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header title={SITE_TITLE} />
    <main>
      <h2 class="intro handwritten-heading handwritten-heading--page">
        Hey! I'm
        <span class="name-wrap">
          <button
            class="name-toggle"
            type="button"
            aria-label="Copy rgo.pt"
            data-cuelume-hover="tick"
          >
            <span class="rodrigo-morph" aria-hidden="true">
              <span class="morph-line">
                <span class="initial-letter">
                  <span class="r-upper">R</span>
                  <span class="r-lower">r</span>
                </span>
                <span class="name-middle">odri</span>
                <span class="name-tail">go</span>
                <span class="pt-suffix"
                  >.<span class="heading-emoji">🇵🇹</span></span
                >
              </span>
            </span>
          </button>
          <span class="dias">Dias</span>
        </span>
        <span class="heading-emoji" aria-hidden="true">👋</span>
      </h2>

      <p>
        <span data-annotate="underline">Self-taught</span> programmer since 14. I
        am <b><DateOfBirth client:load /></b> years old and studying Computer Engineering
        at the Faculty of Engineering of the University of Porto.
      </p>
      <p>
        I care about teaching, learning, <Logo src="firefox" /> web development, <Logo
          src="linux"
        /> Linux, FOSS, self-hosting, and{" "}
        <span data-annotate="underline" data-annotate-delay="1000"
          >minimalism</span
        >. Away from computers, I spend time biking, photographing, lifting, and
        playing table tennis.
      </p>
      <p>
        See <a href="/now">what I'm up to</a>, explore my <a href="/cv"
          >CV and timeline</a
        >, check <a href="/uses">what I use</a>, browse <a href="/faves"
          >favorite media</a
        >, <a href="mailto:hey@rgo.pt">email me</a>, or <a href="/donate"
          >support me</a
        >.
      </p>

      <ul class="socials">
        {
          SOCIALS.map((social) => (
            <li>
              <a
                href={social.url}
                target="_blank"
                aria-label={`${social.icon_name} profile`}
              >
                <Logo src={social.icon_name} size={36} fixed />
              </a>
            </li>
          ))
        }
      </ul>

      <section class="home-section">
        <GitHubContributions client:load />
      </section>

      <section class="home-section">
        <h2>Writings</h2>
        <ul class="writings">
          {
            posts.map((post) => (
              <li>
                <time
                  datetime={post.data.pubDate}
                  transition:name={`blogpost-pubdate-${post.id}`}
                >
                  {new Date(post.data.pubDate).toLocaleDateString("en-us", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </time>
                <a
                  href={"/posts/" + post.id}
                  transition:name={`blogpost-name-${post.id}`}
                >
                  {post.data.title}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
    <Footer />

    <script>
      import { play } from "cuelume";

      function showCopiedToast() {
        play("success");
        window.dispatchEvent(
          new CustomEvent("app:toast", {
            detail: {
              message: "Copied rgo.pt",
              duration: 1700,
            },
          }),
        );
      }

      function showCopyFailedToast() {
        play("error");
        window.dispatchEvent(
          new CustomEvent("app:toast", {
            detail: {
              message: "Copy failed",
              duration: 1700,
            },
          }),
        );
      }

      async function copyDomainToClipboard() {
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText("rgo.pt");
            showCopiedToast();
            return;
          }

          const helper = document.createElement("textarea");
          helper.value = "rgo.pt";
          helper.setAttribute("readonly", "");
          helper.style.position = "absolute";
          helper.style.left = "-9999px";
          document.body.appendChild(helper);
          helper.select();
          const didCopy = document.execCommand("copy");
          document.body.removeChild(helper);

          if (didCopy) {
            showCopiedToast();
          } else {
            showCopyFailedToast();
          }
        } catch {
          showCopyFailedToast();
        }
      }

      // Use event delegation so the handler works even after client-side navigation
      document.addEventListener("click", function (event) {
        const target = event.target;
        if (!target || !(target instanceof Element)) return;

        const nameButton = target.closest(".name-toggle");
        if (nameButton) {
          copyDomainToClipboard();
        }
      });
    </script>
  </body>
</html>

<style>
  .home-section {
    margin-top: 2.6rem;
  }

  .intro {
    margin-bottom: 0.8rem;
  }

  .home-section h2 {
    margin-bottom: 0.9rem;
    color: var(--heading-color);
    font-size: var(--font-size-handwritten-section);
    font-weight: 400;
    font-family: var(--font-family-handwritten);
    line-height: 0.95;
  }

  .heading-emoji {
    display: inline-block;
    font-family:
      "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", sans-serif;
    font-size: 0.56em;
    line-height: 1;
    vertical-align: 0.12em;
  }

  .socials {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0;
    list-style-type: none;
    margin: 1.35rem 0 0 0;
  }

  .socials li {
    list-style-type: none;
  }

  .socials li a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0.72;
    text-decoration: none;
    transition:
      opacity 0.16s ease,
      transform 0.16s ease;
  }

  .socials li > a:hover::before {
    width: 0;
  }

  .socials li > a:hover,
  .socials li > a:focus-visible {
    opacity: 1;
  }

  .writings {
    list-style-type: none;
    padding: 0;
    margin: 0;
  }

  .writings li {
    display: grid;
    grid-template-columns: 8.2rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding: 0.18rem 0;
  }

  .name-wrap {
    display: inline-flex;
    align-items: baseline;
    gap: 0.72rem;
    margin-inline: 0 0.14rem;
    white-space: nowrap;
  }

  .name-toggle {
    position: relative;
    display: inline-block;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    line-height: 1;
    cursor: pointer;
    vertical-align: baseline;
  }

  .name-toggle:not(:hover):not(:focus-visible) .rodrigo-morph {
    animation: rodrigo-hint-glow 2.8s ease-in-out infinite;
  }

  .rodrigo-morph {
    position: relative;
    display: inline-block;
    line-height: 1;
    font-family: inherit;
    vertical-align: baseline;
    overflow: visible;
  }

  .rodrigo-morph::before {
    content: "Rodrigo";
    display: block;
    visibility: hidden;
  }

  .morph-line {
    --name-middle-shift: 1.085em;

    position: absolute;
    top: 0;
    left: 0;
    display: inline-flex;
    align-items: baseline;
    line-height: 1;
    white-space: nowrap;
  }

  .initial-letter {
    position: relative;
    display: inline-grid;
  }

  .r-upper,
  .r-lower {
    grid-area: 1 / 1;
    transition:
      opacity 0.2s ease,
      transform 0.32s cubic-bezier(0.2, 0.75, 0.2, 1);
    will-change: transform, opacity;
  }

  .r-upper {
    opacity: 1;
    transform: translateY(0);
  }

  .r-lower {
    opacity: 0;
    transform: translateY(0.12em) scale(0.94);
  }

  .name-middle {
    display: inline-block;
    white-space: nowrap;
    transition:
      opacity 0.2s ease,
      transform 0.28s cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  .name-tail {
    position: relative;
    display: inline-block;
    transition: transform 0.38s cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  .pt-suffix {
    display: inline-block;
    opacity: 0;
    transform: translate(-0.1em, 0.12em) scale(0.94);
    transition:
      opacity 0.18s ease,
      transform 0.26s cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  .name-toggle:hover .r-upper,
  .name-toggle:focus-visible .r-upper {
    opacity: 0;
    transform: translateY(-0.12em) scale(0.94);
  }

  .name-toggle:hover .r-lower,
  .name-toggle:focus-visible .r-lower {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .name-toggle:hover .name-middle,
  .name-toggle:focus-visible .name-middle {
    opacity: 0;
    transform: translateY(-0.16em) scale(0.94);
  }

  .name-toggle:hover .name-tail,
  .name-toggle:focus-visible .name-tail {
    transform: translateX(calc(var(--name-middle-shift) * -1));
  }

  .name-toggle:hover .pt-suffix,
  .name-toggle:focus-visible .pt-suffix {
    opacity: 1;
    transform: translateX(calc(var(--name-middle-shift) * -1)) scale(1);
    transition-delay: 180ms;
  }

  .dias {
    display: inline-block;
    line-height: 1;
    vertical-align: baseline;
  }

  .name-toggle:focus-visible {
    outline: 2px dashed var(--text-color);
    outline-offset: 0.15rem;
    border-radius: 0.2rem;
  }

  .rodrigo-morph::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -0.14em;
    left: 0;
    height: 1px;
    border-radius: 999px;
    background: currentColor;
    opacity: 0;
    pointer-events: none;
  }

  .name-toggle:not(:hover):not(:focus-visible) .rodrigo-morph::after {
    animation: rodrigo-hint-underline 2.8s ease-in-out infinite;
  }

  @keyframes rodrigo-hint-glow {
    0%,
    100% {
      text-shadow: 0 0 0 transparent;
    }
    50% {
      text-shadow: 0 0 0.34rem
        color-mix(in srgb, currentColor 72%, transparent 28%);
    }
  }

  @keyframes rodrigo-hint-underline {
    0%,
    100% {
      opacity: 0;
      transform: scaleX(0.82);
    }
    50% {
      opacity: 0.36;
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .name-toggle:not(:hover):not(:focus-visible) .rodrigo-morph {
      animation: none;
    }

    .name-toggle:not(:hover):not(:focus-visible) .rodrigo-morph::after {
      animation: none;
    }
  }

  .writings li time {
    font-family: var(--font-family-mono);
    color: var(--gray-color);
    font-size: 0.86rem;
  }

  .writings li a:visited {
    color: var(--visited-color);
  }

  .writings li > a {
    position: relative;
    width: fit-content;
    text-decoration-thickness: 0.05em;
  }

  .writings li > a:hover::before,
  .writings li > a:focus-visible::before {
    content: "→";
    position: absolute;
    left: -1.4rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .writings li > a:hover::after,
  .writings li > a:focus-visible::after {
    content: "←";
    position: absolute;
    right: -1.4rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }

  @media (max-width: 560px) {
    h1 {
      max-width: none;
      font-size: clamp(1.45rem, 6vw, 1.7rem);
      line-height: 1.12;
    }

    .writings li {
      grid-template-columns: 1fr;
      gap: 0;
      padding: 0.45rem 0;
    }

    .writings li > a:hover::before,
    .writings li > a:focus-visible::before,
    .writings li > a:hover::after,
    .writings li > a:focus-visible::after {
      display: none;
    }
  }
</style>
