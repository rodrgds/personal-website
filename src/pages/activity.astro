---
import BaseHead from "../components/common/BaseHead.astro";
import Footer from "../components/common/Footer.astro";
import Header from "../components/common/Header.astro";
import ActivityExplorer from "../components/features/home/ActivityExplorer.svelte";
import { SITE_TITLE } from "../config";

const title = "Activity";
const description =
  "My coding, workouts, problems, movement, and listening history.";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${title} | ${SITE_TITLE}`} {description} />
  </head>
  <body>
    <Header title={SITE_TITLE} />
    <main>
      <h1>{title}</h1>
      <p>
        Choose a metric, period, and grouping to inspect the history I keep for
        this site.
      </p>
      <ActivityExplorer client:load />
    </main>
    <Footer />
  </body>
</html>
