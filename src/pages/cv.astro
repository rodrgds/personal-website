---
import BaseHead from "../components/common/BaseHead.astro";
import Footer from "../components/common/Footer.astro";
import Header from "../components/common/Header.astro";
import CVProcessTable from "../components/features/cv/CVProcessTable.astro";
import { getCVCovers } from "../cv/covers";
import { getCVCollectionsData } from "../cv/data";
import { cvProfiles } from "../cv/profiles";
import { getTimelineEntries } from "../cv/timeline";

const cvData = await getCVCollectionsData();
const timelineEntries = getTimelineEntries(cvData);
const covers = await getCVCovers(cvData);

const profileDownloads = Object.entries(cvProfiles).map(([slug, profile]) => ({
  slug,
  file: slug === "default" ? "cv.pdf" : `cv-${slug}.pdf`,
  label: `Download ${profile.label.replace("Rodrigo Dias - ", "")} as PDF`,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="CV | Rodrigo Dias"
      description="A timeline of my work, projects, education, awards, and courses."
    />
    <script is:inline>
      // The old list view linked entries as /cv?view=list#project-openpost.
      // Each entry now has its own page.
      (function () {
        var match =
          /^#(experience|project|education|honor|certification)-(.+)$/.exec(
            window.location.hash,
          );
        if (match) window.location.replace("/cv/" + match[2]);
      })();
    </script>
  </head>
  <body>
    <Header />
    <main>
      <div class="cv-toolbar">
        <h1 class="cv-command">
          <span class="cv-prompt">$</span> htop{" "}
          <span class="cv-flag">--user</span> rodrigo
        </h1>
        <div class="downloads">
          {profileDownloads.map((profile) => (
            <a
              href={`/cv/${profile.slug}.pdf`}
              class="download"
              title={profile.label}
              aria-label={profile.label}
              data-no-link-fx
            >
              ↓ {profile.file}
            </a>
          ))}
        </div>
      </div>
      <p class="cv-lead">
        Everything I have worked on, as a process list. Running things are what
        I do now. Hover a row for a preview; open it for the full story.
      </p>
      <CVProcessTable entries={timelineEntries} covers={covers} />
    </main>
    <Footer />
  </body>
</html>

<style>
  /* The timeline is a wide dashboard. */
  :global(body:has(.ps) > main) {
    width: min(100%, var(--wide-width));
  }

  .cv-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1ch;
    align-items: center;
    margin-bottom: 0.8rem;
  }

  .cv-command {
    margin: 0;
    color: var(--heading-color);
    font-family: var(--font-family);
    font-size: 1.05rem;
    font-weight: 700;
  }

  .cv-prompt {
    color: var(--tc-host);
  }

  .cv-flag {
    color: var(--tc-tag);
    font-weight: 400;
  }

  .downloads {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-left: auto;
    font-size: 0.82rem;
  }

  .download {
    padding: 0.05rem 0.5rem;
    border: 1px solid var(--border-color);
    color: var(--link-color);
    text-decoration: none;
    text-shadow: none;
  }

  .download:hover {
    border-color: var(--heading-color);
    color: var(--heading-color);
  }

  .cv-lead {
    margin: 0 0 1.2rem;
    color: var(--gray-color);
    font-size: 0.86rem;
  }

  @media (max-width: 640px) {
    .downloads {
      margin-left: 0;
    }
  }
</style>
