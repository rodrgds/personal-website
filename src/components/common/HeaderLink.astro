---
export interface Props extends astroHTML.JSX.AnchorHTMLAttributes {
  href: string;
  external?: boolean;
}

const { href, class: className, external, ...props } = Astro.props;
const { pathname } = Astro.url;
const isActive = href === pathname || href === pathname.replace(/\/$/, "");

// Set the rel attribute accordingly.
const anchorRel = external ? "me noopener noreferrer" : "me";
const target = external ? "_blank" : undefined;
---

<a
  rel={anchorRel}
  href={href}
  target={target}
  class:list={[className, { active: isActive }]}
  data-annotate={isActive ? "underline" : undefined}
  data-annotate-delay={isActive ? "500" : undefined}
  transition:name={isActive ? "active-nav" : undefined}
  {...props}
>
  <span class="label">
    <slot />
  </span>
  {
    external && (
      <span class="external-mark" aria-hidden="true">
        ↗
      </span>
    )
  }
</a>

<style>
  a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    padding-bottom: 0.22rem;
    color: var(--link-color);
    font-size: 0.95rem;
    line-height: 1.2;
    text-decoration: none;
    transition:
      opacity 0.2s ease-out,
      transform 0.2s ease-out;
  }

  a:hover,
  a:focus-visible {
    text-decoration: none;
    opacity: 0.8;
    transform: scale(1.1);
  }

  a.active {
    font-weight: 600;
  }

  .label {
    display: inline-flex;
    align-items: center;
    line-height: 1;
  }

  .external-mark {
    color: var(--gray-color);
  }
</style>
