---
import { ArrowTopRightOnSquareIcon } from "heroicons-svelte/24/outline";

export interface Props extends astroHTML.JSX.AnchorHTMLAttributes {
  href: string;
  external?: boolean;
}

const { href, class: className, external, ...props } = Astro.props;
const { pathname } = Astro.url;
const isActive =
  href === pathname ||
  href === pathname.replace(/\/$/, "") ||
  (href !== "/" && pathname.startsWith(`${href}/`));

// Set the rel attribute accordingly.
const anchorRel = external ? "me noopener noreferrer" : "me";
const target = external ? "_blank" : undefined;
---

<a
  rel={anchorRel}
  href={href}
  target={target}
  class:list={[className, { active: isActive }]}
  aria-current={isActive ? "page" : undefined}
  {...props}
  ><span class="label" data-scramble-hover><slot /></span>
  {external && <ArrowTopRightOnSquareIcon class="ui-icon external-mark" />}</a
>

<style>
  a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    padding: 0.1rem 0.35rem;
    color: var(--text-color);
    font-size: 0.86rem;
    line-height: 1.3;
    text-decoration: none;
    text-shadow: none;
  }

  a:hover,
  a:focus-visible {
    background: var(--surface-hover);
    color: var(--heading-color);
    text-decoration: none;
  }

  a.active {
    background: var(--accent);
    color: var(--background-color);
    font-weight: 700;
  }

  .label {
    display: inline-flex;
    align-items: center;
    line-height: 1.3;
  }

  .external-mark {
    color: var(--gray-color);
  }
</style>
