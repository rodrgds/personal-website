---
import { ArrowTopRightOnSquareIcon } from "heroicons-svelte/24/outline";

export interface Props extends astroHTML.JSX.AnchorHTMLAttributes {
  href: string;
  external?: boolean;
}

const { href, class: className, external, ...props } = Astro.props;
const { pathname } = Astro.url;
const isActive = href === pathname || href === pathname.replace(/\/$/, "");

// Set the rel attribute accordingly.
const anchorRel = external ? "me noopener noreferrer" : "me";
const target = external ? "_blank" : undefined;
---

<a
  rel={anchorRel}
  href={href}
  target={target}
  class:list={[className, { active: isActive }]}
  {...props}
>
  <span class="label">
    <slot />
  </span>
  {external && <ArrowTopRightOnSquareIcon class="ui-icon external-mark" />}
  {
    isActive && (
      <svg
        class="active-line"
        viewBox="0 0 100 8"
        preserveAspectRatio="none"
        transition:name="active-nav"
        aria-hidden="true"
      >
        <path d="M2 4.6 C24 2.2 53 6.4 98 3.5" />
        <path d="M3 5.8 C31 3.3 68 6.8 97 4.4" />
      </svg>
    )
  }
</a>

<style>
  a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    padding-bottom: 0.22rem;
    color: var(--link-color);
    font-size: 0.95rem;
    line-height: 1.2;
    text-decoration: none;
    transition:
      opacity 0.2s ease-out,
      transform 0.2s ease-out;
  }

  a:hover,
  a:focus-visible {
    text-decoration: none;
    opacity: 0.8;
    transform: scale(1.1);
  }

  a.active {
    font-weight: 600;
  }

  .label {
    display: inline-flex;
    align-items: center;
    line-height: 1;
  }

  .external-mark {
    color: var(--gray-color);
  }

  .active-line {
    position: absolute;
    right: -0.08rem;
    bottom: -0.08rem;
    left: -0.08rem;
    width: calc(100% + 0.16rem);
    height: 0.48rem;
    overflow: visible;
    color: var(--flexoki-orange);
    pointer-events: none;
  }

  .active-line path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .active-line path:last-child {
    opacity: 0.74;
  }
</style>
