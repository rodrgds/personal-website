---
import { SOCIALS } from "../../data/socials";
import HeaderLink from "./HeaderLink.astro";
import SocialIcon from "./SocialIcon.astro";

const segment = Astro.url.pathname.replace(/\/$/, "").split("/")[1] ?? "";
const path = segment ? `~/${segment}` : "~";
const primary = SOCIALS.filter((social) => social.primary);
const others = SOCIALS.filter((social) => !social.primary);
---

<header class="site-bar" transition:name="site-bar" transition:animate="none">
  <nav aria-label="Main">
    <a class="prompt" href="/" aria-label="rgo.pt home" data-no-link-fx
      ><span class="prompt-host">rgo.pt</span
      ><span class="prompt-path" data-prompt-path>:{path}</span
      ><span class="prompt-sign">$</span
      ><span class="prompt-cursor" aria-hidden="true"></span></a
    >
    <div class="primary-links">
      <HeaderLink href="/">me</HeaderLink>
      <HeaderLink href="/cv">cv</HeaderLink>
      <HeaderLink href="/uses">uses</HeaderLink>
      <HeaderLink href="/faves">faves</HeaderLink>
    </div>
    <div class="bar-tools">
      <button
        type="button"
        class="tty-button"
        data-tty-open
        title="Open the terminal (: or `)"
        aria-label="Open the terminal"
      >
        :tty
      </button>
      {primary.map((social) => <a
        class="icon-link"
        href={social.url}
        target="_blank"
        rel="me noopener noreferrer"
        title={`${social.label} ${social.handle}`}
        aria-label={social.label}
        data-no-link-fx
        ><SocialIcon name={social.icon_name}
      /></a>)}
      <button
        type="button"
        class="more-socials"
        popovertarget="socials-menu"
        title={others.map((social) => social.label).join(", ")}
        aria-label={`${others.length} more socials`}
      >
        +{others.length}
      </button>
      <a
        class="icon-link"
        href="/rss.xml"
        target="_blank"
        title="RSS feed for the blog"
        aria-label="RSS feed"
        data-no-link-fx
        ><SocialIcon name="rss"
      /></a>
    </div>
  </nav>
  <div id="socials-menu" class="socials-menu" popover data-no-vim>
    <p class="menu-command"><span class="menu-prompt">$</span> ls ~/socials</p>
    <ul>
      {SOCIALS.map((social) => <li>
        <a
          href={social.url}
          target="_blank"
          rel="me noopener noreferrer"
          data-no-link-fx
          ><SocialIcon name={social.icon_name} /><span class="menu-name"
            >{social.label.toLowerCase()}</span
          ><span class="menu-handle">{social.handle}</span></a
        >
      </li>)}
    </ul>
    <p class="menu-hint">or type <kbd>socials</kbd> in the tty</p>
  </div>
</header>
<script>
  import { cue } from "../../lib/sound";

  // The popover is swapped with each page, so listen on the document; toggle
  // does not bubble, so in the capture phase.
  document.addEventListener(
    "toggle",
    (event) => {
      if (!(event instanceof ToggleEvent)) return;
      if (!(event.target instanceof HTMLElement)) return;
      if (event.target.id !== "socials-menu") return;
      cue(event.newState === "open" ? "open" : "close", {
        emphasis: "subtle",
      });
    },
    true,
  );
</script>
<style>
  .site-bar {
    position: sticky;
    top: 0;
    z-index: 20;
    margin-bottom: 2.4rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border-color);
    background: var(--background-color);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    align-items: center;
  }

  .prompt {
    display: inline-flex;
    align-items: center;
    color: var(--tc-host);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    text-shadow: none;
    white-space: nowrap;
  }

  .prompt:hover {
    text-decoration: none;
  }

  .prompt-path {
    color: var(--flexoki-blue);
    font-weight: 500;
  }

  .prompt-sign {
    margin-left: 0.15rem;
    color: var(--gray-color);
    font-weight: 400;
  }

  .prompt-cursor {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    margin-left: 0.35rem;
    background: var(--accent);
    animation: prompt-blink 1s steps(1) infinite;
  }

  @keyframes prompt-blink {
    50% {
      opacity: 0;
    }
  }

  .primary-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem;
  }

  .bar-tools {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    margin-left: auto;
    color: var(--gray-color);
  }

  .icon-link {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    color: var(--gray-color);
    text-decoration: none;
    text-shadow: none;
  }

  .icon-link :global(.social-icon) {
    width: 0.95rem;
    height: 0.95rem;
    fill: currentColor;
  }

  .icon-link:hover,
  .icon-link:focus-visible {
    background: var(--surface-hover);
    color: var(--heading-color);
  }

  .tty-button,
  .more-socials {
    padding: 0 0.35rem;
    border: 1px solid var(--border-color);
    background: transparent;
    color: var(--text-color);
    font-family: var(--font-family);
    font-size: 0.74rem;
    line-height: 1.6;
    cursor: pointer;
  }

  .tty-button {
    margin-right: 0.35rem;
    border-color: var(--tc-host);
    color: var(--tc-host);
  }

  .tty-button:hover,
  .tty-button:focus-visible {
    background: var(--tc-host);
    color: var(--background-color);
  }

  .more-socials {
    margin: 0 0.2rem;
  }

  .more-socials:hover,
  .more-socials:focus-visible,
  .site-bar:has(.socials-menu:popover-open) .more-socials {
    border-color: var(--heading-color);
    background: var(--heading-color);
    color: var(--background-color);
  }

  /* The popover sits under the bar, flush with its right edge. */
  .socials-menu {
    position: fixed;
    inset: 3.3rem
      max(var(--page-padding), calc((100vw - var(--wide-width)) / 2)) auto auto;
    width: min(19rem, calc(100vw - 2 * var(--page-padding)));
    margin: 0;
    padding: 0.6rem 0;
    border: 1px solid var(--border-color);
    background: var(--term-panel);
    color: var(--text-color);
    font-size: 0.8rem;
    box-shadow: 0.35rem 0.35rem 0 rgb(0 0 0 / 0.18);
  }

  .socials-menu:popover-open {
    animation: menu-in 0.16s steps(4, end);
  }

  @keyframes menu-in {
    from {
      clip-path: inset(0 0 100% 0);
    }

    to {
      clip-path: inset(0);
    }
  }

  .menu-command,
  .menu-hint {
    margin: 0;
    padding: 0 0.85rem;
    color: var(--gray-color);
  }

  .menu-command {
    margin-bottom: 0.35rem;
  }

  .menu-prompt {
    color: var(--tc-host);
  }

  .menu-hint {
    margin-top: 0.4rem;
    font-size: 0.72rem;
  }

  .menu-hint kbd {
    color: var(--tc-host);
    font-family: inherit;
  }

  .socials-menu ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .socials-menu li {
    margin: 0;
  }

  .socials-menu a {
    display: grid;
    grid-template-columns: 1rem 6.5rem 1fr;
    gap: 0.6rem;
    align-items: center;
    padding: 0.2rem 0.85rem;
    color: var(--text-color);
    text-decoration: none;
    text-shadow: none;
  }

  .socials-menu a:hover,
  .socials-menu a:focus-visible {
    background: var(--surface-hover);
    color: var(--heading-color);
  }

  .socials-menu :global(.social-icon) {
    width: 0.85rem;
    height: 0.85rem;
    fill: currentColor;
  }

  .menu-name {
    color: var(--tc-path);
  }

  .menu-handle {
    overflow: hidden;
    color: var(--gray-color);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Fixed prompt width so the nav never shifts when the path changes. */
  @media (min-width: 521px) {
    .prompt {
      min-width: 17ch;
    }
  }

  @media (max-width: 520px) {
    .site-bar {
      margin-bottom: 1.6rem;
    }

    .prompt-path {
      display: none;
    }

    .bar-tools {
      margin-left: 0;
    }

    .socials-menu {
      inset-block-start: 5.6rem;
    }
  }

  @media (max-width: 380px) {
    .bar-tools .icon-link:last-child {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .prompt-cursor,
    .socials-menu:popover-open {
      animation: none;
    }
  }
</style>
