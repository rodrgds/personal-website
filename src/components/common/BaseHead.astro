---
import "../../styles/global.css";

export interface Props {
  title: string;
  description: string;
  image?: string;
}

import { ClientRouter } from "astro:transitions";

const { title, description, image = "" } = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />

<script is:inline>
  (() => {
    const STORAGE_KEY = "rgo-theme";
    const root = document.documentElement;
    const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");

    function getStoredTheme() {
      try {
        const value = window.localStorage.getItem(STORAGE_KEY);
        return value === "dark" || value === "light" ? value : null;
      } catch {
        return null;
      }
    }

    function getSystemTheme() {
      return mediaQuery.matches ? "dark" : "light";
    }

    function updateThemeButtons(theme) {
      const nextTheme = theme === "dark" ? "light" : "dark";

      document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
        button.setAttribute("aria-label", `Switch to ${nextTheme} mode`);
        button.setAttribute("title", `Switch to ${nextTheme} mode`);
        button.dataset.themeState = theme;
      });
    }

    function applyTheme(theme) {
      root.dataset.theme = theme;
      root.style.colorScheme = theme;
      updateThemeButtons(theme);
    }

    applyTheme(getStoredTheme() ?? getSystemTheme());

    if (window.__rgoThemeToggleInitialized) return;
    window.__rgoThemeToggleInitialized = true;

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const button = target.closest("[data-theme-toggle]");
      if (!(button instanceof HTMLButtonElement)) return;

      const currentTheme =
        root.dataset.theme === "dark" || root.dataset.theme === "light"
          ? root.dataset.theme
          : getSystemTheme();
      const nextTheme = currentTheme === "dark" ? "light" : "dark";

      try {
        window.localStorage.setItem(STORAGE_KEY, nextTheme);
      } catch {
        // The visible toggle should still work if storage is unavailable.
      }

      applyTheme(nextTheme);
    });

    mediaQuery.addEventListener("change", () => {
      if (getStoredTheme()) return;
      applyTheme(getSystemTheme());
    });

    document.addEventListener("DOMContentLoaded", () => {
      applyTheme(getStoredTheme() ?? getSystemTheme());
    });

    document.addEventListener("astro:page-load", () => {
      applyTheme(getStoredTheme() ?? getSystemTheme());
    });

    document.addEventListener("astro:after-swap", () => {
      applyTheme(getStoredTheme() ?? getSystemTheme());
    });
  })();
</script>

<script>
  import { bind, play, setEnabled } from "cuelume";

  const SOUND_STORAGE_KEY = "rgo-sound-enabled";
  const root = document.documentElement;

  function getSoundPreference(): boolean {
    try {
      return window.localStorage.getItem(SOUND_STORAGE_KEY) !== "false";
    } catch {
      return true;
    }
  }

  function updateSoundButtons(enabled: boolean): void {
    const label = enabled ? "Mute interface sounds" : "Enable interface sounds";

    document.querySelectorAll("[data-sound-toggle]").forEach((button) => {
      button.setAttribute("aria-label", label);
      button.setAttribute("aria-pressed", String(enabled));
      button.setAttribute("title", label);

      if (button instanceof HTMLElement) {
        button.dataset.soundState = enabled ? "on" : "off";
      }
    });
  }

  function applySoundPreference(enabled: boolean): void {
    root.dataset.soundEnabled = enabled ? "true" : "false";
    setEnabled(enabled);
    updateSoundButtons(enabled);
  }

  function toggleSound(): void {
    const wasEnabled = root.dataset.soundEnabled !== "false";
    const isEnabled = !wasEnabled;

    // Let the cue finish before muting; when enabling, unmute first.
    if (wasEnabled) play("toggle");
    applySoundPreference(isEnabled);
    if (isEnabled) play("toggle");

    try {
      window.localStorage.setItem(SOUND_STORAGE_KEY, String(isEnabled));
    } catch {
      // The visible control should still work if storage is unavailable.
    }
  }

  bind();
  applySoundPreference(getSoundPreference());

  if (root.dataset.soundControlsInitialized !== "true") {
    root.dataset.soundControlsInitialized = "true";

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (!target.closest("[data-sound-toggle]")) return;

      toggleSound();
    });

    window.addEventListener("storage", (event) => {
      if (event.key !== SOUND_STORAGE_KEY) return;
      applySoundPreference(event.newValue !== "false");
    });

    document.addEventListener("astro:page-load", () => {
      applySoundPreference(getSoundPreference());
    });

    document.addEventListener("astro:after-swap", () => {
      applySoundPreference(getSoundPreference());
    });
  }
</script>

<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/webp" sizes="32x32" href="/favicon.webp" />
<link rel="alternate" type="application/rss+xml" href="/rss.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="generator" content={Astro.generator} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Umami Analytics -->
<script
  defer
  src="https://cool.rgo.pt/script.js"
  data-website-id="f8aa3433-d34d-4b3a-9eaa-4b828d2a5338"></script>

<script is:inline>
  (() => {
    const TOKEN_CLASS = "animated-link-token";
    const LINE_CLASS = "animated-link-line";
    const RESIZE_DEBOUNCE_MS = 120;
    let resizeTimeout;
    let mutationObserver;

    function shouldEnhanceLink(anchor) {
      if (!(anchor instanceof HTMLAnchorElement)) return false;
      if (!anchor.href) return false;
      if (anchor.closest("astro-island")) return false;
      if (anchor.closest("nav, button, .socials")) return false;
      if (
        anchor.classList.contains("download-pill") ||
        anchor.classList.contains("button") ||
        anchor.classList.contains("project") ||
        anchor.classList.contains("timeline-entry")
      ) {
        return false;
      }
      if (anchor.querySelector(".card-container, div, p, ul, ol, h1, h2, h3")) {
        return false;
      }
      if (anchor.querySelector("img, svg, video, picture, iframe"))
        return false;

      const originalText =
        anchor.dataset.animatedLinkOriginalText ?? anchor.textContent ?? "";
      const normalizedText = originalText.replace(/\s+/g, " ").trim();

      return normalizedText.length > 0;
    }

    function getOriginalText(anchor) {
      if (anchor.dataset.animatedLinkOriginalText) {
        return anchor.dataset.animatedLinkOriginalText;
      }

      const text = (anchor.textContent ?? "").replace(/\s+/g, " ").trim();
      anchor.dataset.animatedLinkOriginalText = text;
      return text;
    }

    function tokenize(text) {
      return text.match(/\S+\s*/g) ?? [text];
    }

    function appendMeasurementTokens(anchor, tokens) {
      anchor.textContent = "";

      for (const token of tokens) {
        const span = document.createElement("span");
        span.className = TOKEN_CLASS;
        span.textContent = token;
        anchor.appendChild(span);
      }
    }

    function groupTokensIntoLines(anchor) {
      const tokenElements = Array.from(
        anchor.querySelectorAll(`.${TOKEN_CLASS}`),
      );
      const lines = [];
      let currentLine = [];
      let previousTop = null;

      for (const token of tokenElements) {
        const top = Math.round(token.getBoundingClientRect().top);

        if (previousTop === null || Math.abs(top - previousTop) <= 1) {
          currentLine.push(token.textContent ?? "");
        } else {
          lines.push(currentLine.join("").trimEnd());
          currentLine = [token.textContent ?? ""];
        }

        previousTop = top;
      }

      if (currentLine.length > 0) {
        lines.push(currentLine.join("").trimEnd());
      }

      return lines.filter(Boolean);
    }

    function renderAnimatedLines(anchor, lines) {
      anchor.textContent = "";
      anchor.dataset.animatedLink = "true";

      lines.forEach((line, index) => {
        const lineSpan = document.createElement("span");
        lineSpan.className = LINE_CLASS;
        lineSpan.textContent = line;
        anchor.appendChild(lineSpan);

        if (index < lines.length - 1) {
          anchor.appendChild(document.createElement("br"));
        }
      });
    }

    function enhanceAnchor(anchor) {
      if (anchor.closest("astro-island")) return;

      if (!shouldEnhanceLink(anchor)) {
        delete anchor.dataset.animatedLink;
        return;
      }

      const originalText = getOriginalText(anchor);
      const tokens = tokenize(originalText);

      appendMeasurementTokens(anchor, tokens);
      const lines = groupTokensIntoLines(anchor);
      renderAnimatedLines(anchor, lines.length > 0 ? lines : [originalText]);
    }

    function enhanceAnchorsIn(root) {
      if (root instanceof Element && root.closest("astro-island")) return;

      if (root instanceof HTMLAnchorElement) {
        enhanceAnchor(root);
        return;
      }

      if (!(root instanceof Element || root instanceof Document)) return;

      const anchors = root.querySelectorAll("a[href]");
      for (const anchor of anchors) {
        enhanceAnchor(anchor);
      }
    }

    function enhanceAnimatedLinks() {
      enhanceAnchorsIn(document);
    }

    function queueEnhancement() {
      window.clearTimeout(resizeTimeout);
      resizeTimeout = window.setTimeout(
        enhanceAnimatedLinks,
        RESIZE_DEBOUNCE_MS,
      );
    }

    function observeInsertedLinks() {
      mutationObserver?.disconnect();

      if (!document.body) return;

      mutationObserver = new MutationObserver((mutations) => {
        for (const mutation of mutations) {
          for (const node of mutation.addedNodes) {
            requestAnimationFrame(() => enhanceAnchorsIn(node));
          }
        }
      });

      mutationObserver.observe(document.body, {
        childList: true,
        subtree: true,
      });
    }

    document.addEventListener("astro:page-load", () => {
      enhanceAnimatedLinks();
      observeInsertedLinks();
    });

    document.addEventListener("astro:after-swap", () => {
      enhanceAnimatedLinks();
      observeInsertedLinks();
    });

    window.addEventListener("resize", queueEnhancement);
  })();
</script>

<script is:inline>
  (() => {
    // External link hover previews, modeled after cmrg.me's link preview
    // cards: a short dwell on an external prose link fetches Open Graph
    // metadata from /api/link-preview and shows a small card beside the
    // link. Hover-only devices; keyboard and touch users keep plain links.
    const HOVER_CAPABLE = window.matchMedia(
      "(hover: hover) and (pointer: fine)",
    );
    const DWELL_MS = 350;
    const CARD_WIDTH = 288;
    const OFFSET = 12;
    const VIEWPORT_PAD = 10;

    if (!HOVER_CAPABLE.matches) return;

    const EXCLUSION_SELECTOR =
      "nav, button, .socials, .download-pill, .button, .project, .timeline-entry";
    const BLOCK_CHILD_SELECTOR =
      ".card-container, div, p, ul, ol, h1, h2, h3, img, svg, video, picture, iframe";

    let card = null;
    let activeLink = null;
    let dwellTimer = 0;
    let fetchController = null;
    let cardX = 0;
    let cardY = 0;
    const metaCache = new Map();

    function isExternalProseLink(anchor) {
      if (!(anchor instanceof HTMLAnchorElement)) return false;
      if (!anchor.href) return false;
      if (anchor.closest("astro-island")) return false;
      if (anchor.closest(EXCLUSION_SELECTOR)) return false;
      if (anchor.querySelector(BLOCK_CHILD_SELECTOR)) return false;
      try {
        const url = new URL(anchor.href);
        if (url.protocol !== "http:" && url.protocol !== "https:") {
          return false;
        }
        return url.hostname !== window.location.hostname;
      } catch {
        return false;
      }
    }

    function markExternalLinks() {
      const anchors = document.querySelectorAll("a[href]");
      for (const anchor of anchors) {
        if (anchor.dataset.externalPreview === "true") continue;
        if (!isExternalProseLink(anchor)) continue;
        anchor.dataset.externalPreview = "true";
        // A soft tick while the preview is being considered.
        anchor.setAttribute("data-cuelume-hover", "tick");
      }
    }

    function cardSkeleton() {
      const el = document.createElement("div");
      el.className = "link-preview-card";
      el.setAttribute("aria-hidden", "true");
      el.innerHTML =
        '<div class="link-preview-card-inner">' +
        '<div class="link-preview-image">' +
        '<img alt="" referrerpolicy="no-referrer" decoding="async" loading="lazy" />' +
        '<div class="link-preview-loading" aria-hidden="true">' +
        "<i></i><i></i><i></i>" +
        "</div>" +
        "</div>" +
        '<div class="link-preview-text">' +
        '<div class="link-preview-domain"></div>' +
        '<h4 class="link-preview-title"></h4>' +
        '<p class="link-preview-desc"></p>' +
        "</div>" +
        "</div>";
      return el;
    }

    function getCard() {
      // View transitions replace <body>, so rebuild if we lost our card.
      if (!card || !card.isConnected) {
        card = cardSkeleton();
        document.body.appendChild(card);
      }
      return card;
    }

    function renderCard(meta) {
      const el = getCard();
      const imageWrap = el.querySelector(".link-preview-image");
      const img = el.querySelector("img");
      const domain = el.querySelector(".link-preview-domain");
      const title = el.querySelector(".link-preview-title");
      const desc = el.querySelector(".link-preview-desc");

      // The image slot keeps its fixed aspect-ratio box whether or not the
      // image loads, so the card height (and its position) never changes
      // after it is placed. A failed image just shows a quiet gradient.
      const hasImage = Boolean(meta.image);
      imageWrap.classList.toggle("has-image", hasImage);
      imageWrap.classList.remove("is-loaded", "is-broken");
      img.removeAttribute("src");
      img.onload = null;
      img.onerror = null;

      if (hasImage) {
        img.onload = () => {
          imageWrap.classList.add("is-loaded");
          imageWrap.classList.remove("is-broken");
          repositionCard();
        };
        img.onerror = () => {
          imageWrap.classList.add("is-broken");
          repositionCard();
        };
        img.src = meta.image;
      }

      if (meta.handle) {
        domain.replaceChildren();
        const host = document.createElement("span");
        host.className = "link-preview-host";
        host.textContent = meta.domain;
        const sep = document.createElement("span");
        sep.className = "link-preview-sep";
        sep.setAttribute("aria-hidden", "true");
        sep.textContent = "/";
        const path = document.createElement("span");
        path.className = "link-preview-handle";
        path.textContent = meta.handle;
        domain.append(host, sep, path);
      } else {
        domain.textContent = meta.domain;
      }

      title.textContent = meta.title || meta.domain;
      if (meta.description) {
        desc.textContent = meta.description;
        desc.hidden = false;
      } else {
        desc.hidden = true;
      }
    }

    function positionCard(link) {
      const el = getCard();
      const inner = el.querySelector(".link-preview-card-inner");
      const rect = link.getBoundingClientRect();
      // The card sits at scale(0.94) before it is shown, which skews
      // getBoundingClientRect measurements. Normalize before flipping logic.
      const currentScale =
        card?.getAttribute("data-shown") === "true" ? 1 : 0.94;
      const cardHeight = inner.getBoundingClientRect().height / currentScale;
      const viewportWidth = window.innerWidth;
      const viewportHeight = window.innerHeight;

      const belowTop = rect.bottom + OFFSET;
      const aboveTop = rect.top - OFFSET - cardHeight;
      const placeBelow = belowTop + cardHeight <= viewportHeight - VIEWPORT_PAD;
      const placeAbove = aboveTop >= VIEWPORT_PAD;
      const top = placeBelow ? belowTop : placeAbove ? aboveTop : belowTop;

      const left = Math.min(
        Math.max(rect.left, VIEWPORT_PAD),
        viewportWidth - VIEWPORT_PAD - CARD_WIDTH,
      );

      cardX = left;
      cardY = top;
      el.style.transformOrigin = placeBelow ? "top center" : "bottom center";
      applyCardTransform(card.getAttribute("data-shown") === "true" ? 1 : 0.94);
    }

    function applyCardTransform(scale) {
      if (!card) return;
      card.style.transform = `translate(${cardX}px, ${cardY}px) scale(${scale})`;
    }

    function repositionCard() {
      if (activeLink && card && card.getAttribute("data-shown") === "true") {
        positionCard(activeLink);
      }
    }

    function showCard() {
      getCard().setAttribute("data-shown", "true");
      applyCardTransform(1);
    }

    function hideCard() {
      if (card && card.isConnected) {
        card.removeAttribute("data-shown");
        applyCardTransform(0.94);
      }
    }

    function cancelDwell() {
      window.clearTimeout(dwellTimer);
      dwellTimer = 0;
      if (fetchController) {
        fetchController.abort();
        fetchController = null;
      }
      activeLink = null;
    }

    function dismiss() {
      cancelDwell();
      hideCard();
    }

    async function fetchAndShow(link) {
      const url = link.href;
      link.classList.add("is-preview-loading");
      try {
        let meta = metaCache.get(url);
        if (!meta) {
          fetchController = new AbortController();
          try {
            const response = await fetch(
              `/api/link-preview?url=${encodeURIComponent(url)}`,
              {
                signal: fetchController.signal,
                headers: { accept: "application/json" },
              },
            );
            meta = response.ok ? await response.json() : {};
          } catch {
            meta = {};
          }
          fetchController = null;
          metaCache.set(url, meta);
        }

        if (activeLink !== link) return;
        if (!meta.title && !meta.description && !meta.image) return;

        renderCard(meta);
        positionCard(link);
        showCard();
      } finally {
        link.classList.remove("is-preview-loading");
      }
    }

    function enter(link) {
      dismiss();
      activeLink = link;
      dwellTimer = window.setTimeout(() => {
        void fetchAndShow(link);
      }, DWELL_MS);
    }

    function handlePointerOver(event) {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const link = target.closest('a[data-external-preview="true"]');
      if (link) enter(link);
    }

    function handlePointerOut(event) {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const link = target.closest('a[data-external-preview="true"]');
      if (!link) return;
      if (
        event.relatedTarget instanceof Node &&
        link.contains(event.relatedTarget)
      ) {
        return;
      }
      if (activeLink === link) dismiss();
    }

    if (window.__rgoLinkPreviewInitialized) {
      markExternalLinks();
    } else {
      window.__rgoLinkPreviewInitialized = true;
      document.addEventListener("pointerover", handlePointerOver);
      document.addEventListener("pointerout", handlePointerOut);
      document.addEventListener("scroll", dismiss, {
        capture: true,
        passive: true,
      });
      window.addEventListener("resize", dismiss, { passive: true });

      document.addEventListener("astro:page-load", markExternalLinks);
      document.addEventListener("astro:after-swap", () => {
        dismiss();
        markExternalLinks();
      });
    }

    markExternalLinks();
  })();
</script>

<script>
  import { annotate } from "rough-notation";

  // Hand-drawn underline annotations, the same rough-notation effect cmrg.me
  // uses on key phrases. Targets carry data-annotate="underline"; the stroke
  // is themed through CSS (.rough-annotation path) and draws itself on page
  // load. An optional data-annotate-delay (ms) staggers the draw-in.
  // Hover underlines for prose links use the CSS ::before animation instead
  // (smooth retract on leave). Reduced motion users keep the plain underline.
  let annotations: ReturnType<typeof annotate>[] = [];
  let pendingTimers = new Set<number>();

  function clearAnnotations(): void {
    for (const timer of pendingTimers) window.clearTimeout(timer);
    pendingTimers.clear();
    for (const annotation of annotations) annotation.remove();
    annotations = [];
  }

  function underlineFor(target: HTMLElement): void {
    if (target.closest("astro-island")) return;

    const annotation = annotate(target, {
      type: "underline",
      color: "currentColor",
      strokeWidth: 2,
      padding: 4,
      animationDuration: 700,
      iterations: 2,
    });
    annotations.push(annotation);

    const delay = Number(target.dataset.annotateDelay) || 0;
    if (delay > 0) {
      const timer = window.setTimeout(() => annotation.show(), delay);
      pendingTimers.add(timer);
    } else {
      annotation.show();
    }
  }

  function annotateTargets(): void {
    clearAnnotations();

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      return;
    }

    const targets = document.querySelectorAll<HTMLElement>("[data-annotate]");
    for (const target of targets) {
      underlineFor(target);
    }
  }

  document.addEventListener("astro:page-load", annotateTargets);
  document.addEventListener("astro:after-swap", annotateTargets);
</script>

<!-- View Transitions -->
<ClientRouter />
