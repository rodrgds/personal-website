---
import ToastHost from "./ToastHost.astro";

const today = new Date();
---

<footer transition:name="footer" class="status-line">
  <p class="status-left">
    <span class="status-mode">NORMAL</span>
    <span>&copy; {today.getFullYear()}</span>
    <a href="/">rodrigo dias</a>
    <a href="/ssh.pub" class="pubkey">me.pub</a>
    <span>all <s>rights</s> <i>lefts</i> reserved</span>
  </p>
  <div class="status-right" role="group" aria-label="Site preferences">
    <button
      class="footer-toggle theme-toggle"
      type="button"
      data-theme-toggle
      data-cuelume-toggle
      aria-label="Switch color theme"
      title="Switch color theme"
    >
      <span class="theme-icon theme-icon-light">light</span
      ><span class="theme-icon theme-icon-dark">dark</span>
    </button>
    <button
      class="footer-toggle sound-toggle"
      type="button"
      data-sound-toggle
      aria-label="Mute interface sounds"
      aria-pressed="true"
      title="Mute interface sounds"
    >
      <span class="sound-icon sound-icon-on">sound on</span
      ><span class="sound-icon sound-icon-off">muted</span>
    </button>
    <span class="status-utf">utf-8</span>
  </div>
</footer>
<ToastHost />
<style>
  .status-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    align-items: center;
    justify-content: space-between;
    margin-top: 4rem;
    margin-bottom: 1.5rem;
    padding: 0.35rem 0;
    border-top: 1px solid var(--border-color);
    color: var(--gray-color);
    font-size: 0.74rem;
  }

  .status-left {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.8rem;
    align-items: center;
    margin: 0;
  }

  .status-mode {
    padding: 0 0.4rem;
    background: var(--accent);
    color: var(--background-color);
    font-weight: 700;
  }

  .status-right {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }

  .footer-toggle {
    padding: 0 0.2rem;
    border: 0;
    background: transparent;
    color: var(--link-color);
    font: inherit;
    line-height: 1.4;
  }

  .footer-toggle::before,
  .footer-toggle::after {
    display: inline-block;
    transition: transform 0.16s steps(2, end);
  }

  .footer-toggle::before {
    content: "[";
  }

  .footer-toggle::after {
    content: "]";
  }

  /* Brackets step out a character on hover. */
  .footer-toggle:hover::before,
  .footer-toggle:focus-visible::before {
    transform: translateX(-0.6ch);
  }

  .footer-toggle:hover::after,
  .footer-toggle:focus-visible::after {
    transform: translateX(0.6ch);
  }

  .footer-toggle:hover,
  .footer-toggle:focus-visible {
    background: var(--accent);
    color: var(--background-color);
  }

  .theme-icon,
  .sound-icon {
    display: none;
  }

  .theme-toggle[data-theme-state="light"] .theme-icon-dark,
  .theme-toggle:not([data-theme-state]) .theme-icon-dark,
  .theme-toggle[data-theme-state="dark"] .theme-icon-light,
  .sound-toggle[data-sound-state="on"] .sound-icon-on,
  .sound-toggle:not([data-sound-state]) .sound-icon-on,
  .sound-toggle[data-sound-state="off"] .sound-icon-off {
    display: inline;
  }

  a {
    color: inherit;
    text-shadow: none;
  }

  a:hover {
    color: var(--link-color);
  }

  @media (max-width: 520px) {
    .status-utf {
      display: none;
    }
  }
</style>
