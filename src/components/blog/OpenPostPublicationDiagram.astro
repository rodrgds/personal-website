<figure class="diagram" aria-labelledby="openpost-publication-caption">
  <div class="canvas">
    <svg
      viewBox="0 0 760 460"
      role="img"
      aria-labelledby="publication-title publication-desc"
    >
      <title id="publication-title">
        OpenPost publication and rendition data model
      </title>
      <desc id="publication-desc"
        >One canonical publication contains ordered source segments. Each
        selected account gets a rendition with its own destination-specific
        segments, media, settings, provider identifiers, publish status, and
        retry state.</desc
      >
      <defs>
        <marker
          id="publication-arrow"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="7"
          markerHeight="7"
          orient="auto"
        >
          <path d="M0 0 10 5 0 10z" class="arrow-head"></path>
        </marker>
      </defs>

      <g class="arrows">
        <path d="M380 109V139"></path>
        <path d="M380 211V248H205V280"></path>
        <path d="M380 248H555V280"></path>
      </g>

      <g class="node canonical">
        <rect x="222" y="24" width="316" height="85" rx="7"></rect>
        <text x="244" y="53" class="title">Publication</text>
        <text x="244" y="77" class="detail"
          >canonical intent · schedule · revision</text
        >
        <text x="516" y="53" text-anchor="end" class="tag">SOURCE</text>
      </g>
      <g class="node segments">
        <rect x="252" y="139" width="256" height="72" rx="6"></rect>
        <text x="270" y="168" class="title">Ordered source segments</text>
        <text x="270" y="191" class="detail"
          >text · title · media · settings</text
        >
      </g>
      <g class="node rendition success">
        <rect x="48" y="280" width="314" height="148" rx="7"></rect>
        <text x="70" y="311" class="title">Rendition: account A</text>
        <text x="340" y="311" text-anchor="end" class="tag state-success"
          >PUBLISHED</text
        >
        <line x1="70" y1="328" x2="340" y2="328"></line>
        <text x="70" y="354" class="detail">destination segments + media</text>
        <text x="70" y="378" class="detail"
          >profile · settings · provider ID</text
        >
        <text x="70" y="402" class="detail">own URL · status · lifecycle</text>
      </g>
      <g class="node rendition retry">
        <rect x="398" y="280" width="314" height="148" rx="7"></rect>
        <text x="420" y="311" class="title">Rendition: account B</text>
        <text x="690" y="311" text-anchor="end" class="tag state-retry"
          >RETRYING</text
        >
        <line x1="420" y1="328" x2="690" y2="328"></line>
        <text x="420" y="354" class="detail">destination segments + media</text>
        <text x="420" y="378" class="detail"
          >error kind · retry time · action</text
        >
        <text x="420" y="402" class="detail">independent from account A</text>
      </g>
    </svg>
  </div>
  <figcaption id="openpost-publication-caption">
    Cross-posting is one source intent with separate destination state, not one
    row with an array of networks.
  </figcaption>
</figure>

