---
export interface Props {
  /** One box per item. "Title|detail" adds a smaller second line. */
  items: string[];
  direction?: "row" | "column";
  /** Reveal one box per step, starting at this step. */
  at?: number;
  /** Item indexes drawn in the accent colour. */
  highlight?: number[];
}

const { items, direction = "row", at, highlight = [] } = Astro.props;
---

<ol class:list={["flow", `flow--${direction}`]}>
  {
    items.map((item, index) => {
      const [title, detail] = item.split("|");
      return (
        <li
          class:list={[
            "flow-item",
            highlight.includes(index) && "flow-item--hot",
          ]}
          data-show={at === undefined ? undefined : String(at + index)}
          data-fx="up"
        >
          <strong>{title}</strong>
          {detail && <span>{detail}</span>}
        </li>
      );
    })
  }
</ol>
