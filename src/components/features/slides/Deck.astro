---
import {
  ChevronLeft,
  ChevronRight,
  CircleHelp,
  Eraser,
  Highlighter,
  LayoutGrid,
  MousePointer2,
  MoveUpRight,
  Pen,
  Presentation,
  Square,
  Type,
  Wand,
} from "lucide-astro";
import "./deck.css";

export interface Props {
  slug: string;
  title: string;
  description: string;
  lang: string;
  video?: string;
}

const { slug, title, description, lang, video } = Astro.props;
const canonical = new URL(`/slides/${slug}`, Astro.site ?? Astro.url);
const shortcuts = [
  ["→ · space · PageDown", "next"],
  ["← · PageUp", "back"],
  ["Shift + → / ←", "skip steps"],
  ["M", "map of every slide"],
  ["F · Esc", "back to the current slide"],
  ["W", "whiteboard"],
  ["space + drag · middle drag · wheel", "move the view"],
  ["Middle click", "go to that slide (any tool)"],
  ["Ctrl/⌘ + wheel · pinch", "zoom"],
  ["V", "move and interact"],
  ["P · H", "pen · highlighter"],
  ["A · R · O · T", "arrow · rectangle · ellipse · text"],
  ["E · L", "eraser · laser"],
  ["1–8 · [ ]", "colour · thickness"],
  ["⌘Z · ⇧⌘Z", "undo · redo"],
  ["C · Shift + C", "clear slide · clear all"],
  ["S", "speaker view (new window)"],
  ["D · U", "theme · hide the interface"],
];
const colors = [
  ["ink", "Ink"],
  ["red", "Red"],
  ["orange", "Orange"],
  ["yellow", "Yellow"],
  ["green", "Green"],
  ["cyan", "Cyan"],
] as const;
const tools = [
  ["interact", "Move and interact", "V", MousePointer2],
  ["pen", "Pen", "P", Pen],
  ["highlighter", "Highlighter", "H", Highlighter],
  ["arrow", "Arrow", "A", MoveUpRight],
  ["rect", "Rectangle", "R", Square],
  ["text", "Text", "T", Type],
  ["eraser", "Eraser", "E", Eraser],
  ["laser", "Laser", "L", Wand],
] as const;
---

<!doctype html>
<html lang={lang} data-deck-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/webp" sizes="32x32" href="/favicon.webp" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link
      rel="preload"
      href="/fonts/geist-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin-variable-wghtOnly-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script
      is:inline
      defer
      src="https://cool.rgo.pt/script.js"
      data-website-id="f8aa3433-d34d-4b3a-9eaa-4b828d2a5338"></script>
    <script is:inline>
      (() => {
        let theme = "dark";
        try {
          const stored = window.localStorage.getItem("slides:theme");
          if (stored === "light" || stored === "dark") theme = stored;
        } catch {
          // Default theme.
        }
        document.documentElement.dataset.deckTheme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
  </head>
  <body class="deck-body">
    <div
      class="deck"
      data-deck
      data-slug={slug}
      data-loading
      data-tool="interact"
    >
      <div class="deck-viewport" data-viewport>
        <div class="deck-world" data-world>
          <div class="deck-map" data-map>
            <slot />
            <section class="deck-part deck-board" aria-label="Whiteboard">
              <h2 class="deck-part-title">Board</h2>
              <div class="deck-part-row">
                <div class="board-frame" data-board-frame></div>
                <div class="board-frame"></div>
              </div>
            </section>
          </div>
          <svg class="deck-ink" data-ink aria-hidden="true"></svg>
        </div>
        <div class="deck-input" data-input></div>
        <svg class="deck-overlay" data-overlay aria-hidden="true"></svg>
      </div>

      <div class="deck-toolbar" data-toolbar role="toolbar" aria-label="Tools">
        <div class="tb-group">
          <button
            type="button"
            data-action="prev"
            title={`Previous (←)`}
            aria-label="Previous"
          >
            <ChevronLeft size={18} />
          </button>
          <span class="tb-counter" data-counter aria-live="polite"></span>
          <button
            type="button"
            data-action="next"
            title={`Next (→)`}
            aria-label="Next"
          >
            <ChevronRight size={18} />
          </button>
        </div>
        <div class="tb-group tb-draw">
          {
            tools.map(([tool, label, key, Icon]) => (
              <button
                type="button"
                data-tool={tool}
                title={`${label} (${key})`}
                aria-label={label}
              >
                <Icon size={18} />
              </button>
            ))
          }
        </div>
        <div class="tb-group tb-colors">
          {
            colors.map(([color, label], index) => (
              <button
                type="button"
                class="tb-swatch"
                data-color={color}
                title={`${label} (${index + 1})`}
                aria-label={label}
              />
            ))
          }
        </div>
        <div class="tb-group">
          <button
            type="button"
            data-action="overview"
            title={`Map (M)`}
            aria-label="Slide map"
          >
            <LayoutGrid size={18} />
          </button>
          <button
            type="button"
            data-action="speaker"
            class="tb-presenter"
            title={`Speaker view (S)`}
            aria-label="Speaker view"
          >
            <Presentation size={18} />
          </button>
          <button
            type="button"
            data-action="help"
            title={`Shortcuts (?)`}
            aria-label="Keyboard shortcuts"
          >
            <CircleHelp size={18} />
          </button>
        </div>
      </div>

      <div class="deck-help" data-help hidden>
        <div
          class="deck-help-panel"
          role="dialog"
          aria-modal="true"
          aria-labelledby="deck-help-title"
        >
          <header>
            <h2 id="deck-help-title">Shortcuts</h2>
            <button type="button" data-help-close aria-label="Close">×</button>
          </header>
          <dl>
            {
              shortcuts.map(([keys, action]) => (
                <>
                  <dt>{keys}</dt>
                  <dd>{action}</dd>
                </>
              ))
            }
          </dl>
          <p>
            Drawings stay in this browser.
            {
              video && (
                <>
                  {" "}
                  <a href={video} target="_blank" rel="noreferrer">
                    Watch the video
                  </a>
                  .
                </>
              )
            }
            {" "}
            <a href="?script">Full script</a> · <a href="/slides"
              >Other presentations</a
            >.
          </p>
        </div>
      </div>

      <div class="deck-speaker" data-speaker hidden>
        <header class="speaker-bar">
          <strong data-speaker-title></strong>
          <span data-speaker-position></span>
          <span class="speaker-clock" data-speaker-clock></span>
        </header>
        <section class="speaker-main">
          <div class="speaker-frame" data-speaker-current></div>
          <div class="speaker-controls">
            <button
              type="button"
              data-speaker-action="prev"
              aria-label="Previous">←</button
            >
            <button
              type="button"
              class="speaker-timer"
              data-speaker-action="timer"
              title="Start or pause (T)"
            >
              <span data-speaker-timer>00:00</span>
            </button>
            <button
              type="button"
              data-speaker-action="reset"
              title="Reset the timer">reset</button
            >
            <button type="button" data-speaker-action="next" aria-label="Next"
              >→</button
            >
          </div>
        </section>
        <section class="speaker-side">
          <p class="speaker-label" data-speaker-next-label></p>
          <div class="speaker-frame speaker-frame--next" data-speaker-next>
          </div>
          <div class="speaker-notes-bar">
            <span class="speaker-label">Notes</span>
            <span>
              <button
                type="button"
                data-speaker-action="smaller"
                aria-label="Smaller text">A−</button
              >
              <button
                type="button"
                data-speaker-action="larger"
                aria-label="Larger text">A+</button
              >
              <button
                type="button"
                data-speaker-action="theme"
                aria-label="Change theme">theme</button
              >
            </span>
          </div>
          <div class="speaker-notes" data-speaker-notes data-scrollable></div>
        </section>
      </div>

      <div class="deck-script" data-script hidden>
        <header>
          <p class="script-kicker">Script</p>
          <h1>{title}</h1>
          <p>{description}</p>
          <p class="script-stats" data-script-stats></p>
        </header>
        <div data-script-list></div>
      </div>
    </div>

    <script>
      import { initDeck } from "./runtime/deck";

      initDeck();
    </script>
  </body>
</html>
