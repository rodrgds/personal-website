---
import CVEntryAvatar from "./CVEntryAvatar.astro";
import { ArrowRightIcon } from "heroicons-svelte/24/outline";
import {
  TIMELINE_CATEGORIES,
  TIMELINE_CATEGORY_LABELS,
  buildTimelineLayout,
  getTimelineDateLabel,
  type TimelineEntry,
  type TimelineCategory,
} from "../../../cv/timeline";

interface Props {
  entries: TimelineEntry[];
  variant?: "detailed" | "icons";
}

interface TrackPoint {
  offset: number;
  row: number;
}

interface EvenLanePosition {
  row: number;
  lanePoints: TrackPoint[];
}

const { entries, variant = "detailed" }: Props = Astro.props;
const compact = variant === "icons";
const layout = buildTimelineLayout(entries);
type PositionedEntry = (typeof layout.entries)[number];

interface EvenLaneEvent {
  endingEntries: PositionedEntry[];
  startingEntries: PositionedEntry[];
}

const monthWidth = 20;
const eventStep = compact ? 52 : 200;
const evenEndGapRatio = 0.4;
const contentInset = 34;
const labelSpace = compact ? 34 : 220;
const rowHeight = compact ? 38 : 66;
const linearTimeWidth = layout.monthCount * monthWidth + contentInset * 2;
const linearTimelineWidth = linearTimeWidth + labelSpace;
const evenTimeWidth = layout.entries.length * eventStep + contentInset * 2;
const evenTimelineWidth = evenTimeWidth + labelSpace;
const linearGraphRowCount = compact
  ? layout.rowCount
  : Math.max(layout.rowCount, layout.labelRowCount);
const graphBottomSpace = compact ? 18 : 34;
const nodeCenter = compact ? 17 : 22;

const categoryColors = {
  experience: "var(--flexoki-orange)",
  "personal-projects": "var(--flexoki-cyan)",
  "university-projects": "var(--flexoki-green)",
  education: "var(--flexoki-blue)",
  honors: "var(--flexoki-yellow)",
  certifications: "var(--flexoki-purple)",
} satisfies Record<TimelineCategory, string>;

const getStartOffset = (entry: PositionedEntry) =>
  (entry.startMonth - layout.startMonth) * monthWidth + contentInset;

const getMonthOffset = (month: number) =>
  (month - layout.startMonth) * monthWidth + contentInset;

const getEvenStartOffset = (index: number) => index * eventStep + contentInset;

const evenEntryOffsets = new Map(
  layout.entries.map((entry, index) => [entry.id, getEvenStartOffset(index)]),
);

const getEvenEntryOffset = (entry: PositionedEntry) =>
  evenEntryOffsets.get(entry.id) ?? contentInset;

const getEvenMonthOffset = (month: number) => {
  const entryIndex = layout.entries.findIndex(
    (entry) => entry.startMonth >= month,
  );
  const offsetIndex = entryIndex === -1 ? layout.entries.length : entryIndex;
  return getEvenStartOffset(offsetIndex);
};

const getEvenEndOffset = (entry: PositionedEntry) => {
  const nextEntryIndex = layout.entries.findIndex(
    (candidate) => candidate.startMonth > entry.endMonth,
  );
  const previousEntryIndex =
    nextEntryIndex === -1 ? layout.entries.length - 1 : nextEntryIndex - 1;
  const boundaryIndex =
    nextEntryIndex === -1 ? layout.entries.length : nextEntryIndex;

  const previousOffset = getEvenStartOffset(previousEntryIndex);
  const boundaryOffset = getEvenStartOffset(boundaryIndex);
  return previousOffset + (boundaryOffset - previousOffset) * evenEndGapRatio;
};

const evenLaneEvents = new Map<number, EvenLaneEvent>();

const getEvenLaneEvent = (offset: number) => {
  const existingEvent = evenLaneEvents.get(offset);
  if (existingEvent) return existingEvent;

  const event: EvenLaneEvent = {
    endingEntries: [],
    startingEntries: [],
  };
  evenLaneEvents.set(offset, event);
  return event;
};

layout.entries.forEach((entry, index) => {
  getEvenLaneEvent(getEvenStartOffset(index)).startingEntries.push(entry);

  if (entry.kind === "span" && entry.endDate) {
    getEvenLaneEvent(getEvenEndOffset(entry)).endingEntries.push(entry);
  }
});

// Active entries stay ordered from oldest to newest. Ending a span compacts
// every newer active span immediately; point events never join the active set.
const evenLanePositions = new Map<string, EvenLanePosition>();
let activeEvenEntries: PositionedEntry[] = [];
let evenGraphRowCount = 1;

for (const [offset, event] of [...evenLaneEvents].sort(
  ([firstOffset], [secondOffset]) => firstOffset - secondOffset,
)) {
  const endingEntryIds = new Set(event.endingEntries.map((entry) => entry.id));
  activeEvenEntries = activeEvenEntries.filter(
    (entry) => !endingEntryIds.has(entry.id),
  );

  activeEvenEntries.forEach((activeEntry, row) => {
    const position = evenLanePositions.get(activeEntry.id);
    if (position?.lanePoints.at(-1)?.row !== row) {
      position?.lanePoints.push({ offset, row });
    }
  });

  for (const entry of event.startingEntries) {
    const row = activeEvenEntries.length;
    evenLanePositions.set(entry.id, {
      row,
      lanePoints: [{ offset, row }],
    });

    if (entry.kind === "span") {
      activeEvenEntries.push(entry);
    }

    evenGraphRowCount = Math.max(
      evenGraphRowCount,
      row + 1,
      activeEvenEntries.length,
    );
  }
}

const linearGraphHeight = linearGraphRowCount * rowHeight + graphBottomSpace;
const evenGraphHeight = evenGraphRowCount * rowHeight + graphBottomSpace;

const getEvenLanePosition = (entry: PositionedEntry): EvenLanePosition =>
  evenLanePositions.get(entry.id) ?? {
    row: entry.row,
    lanePoints: [{ offset: getEvenEntryOffset(entry), row: entry.row }],
  };

const getLaneCenter = (row: number) => row * rowHeight + nodeCenter;

const getTrackPath = (
  startOffset: number,
  endOffset: number,
  initialRow: number,
  points: TrackPoint[],
  maximumTransitionWidth: number,
) => {
  let currentRow = points[0]?.row ?? initialRow;
  let path = `M ${startOffset} ${getLaneCenter(currentRow)}`;
  const laneChanges = points.slice(1);

  for (const [index, point] of laneChanges.entries()) {
    const transition = point.offset;
    const nextTransition = laneChanges[index + 1]
      ? laneChanges[index + 1].offset
      : endOffset;
    const transitionEnd = Math.min(
      endOffset,
      nextTransition,
      transition + maximumTransitionWidth,
    );
    const transitionWidth = transitionEnd - transition;
    const firstControl = transition + transitionWidth * 0.42;
    const secondControl = transition + transitionWidth * 0.58;
    const currentY = getLaneCenter(currentRow);
    const nextY = getLaneCenter(point.row);

    path += ` L ${transition} ${currentY}`;
    path += ` C ${firstControl} ${currentY}, ${secondControl} ${nextY}, ${transitionEnd} ${nextY}`;
    currentRow = point.row;
  }

  return `${path} L ${endOffset} ${getLaneCenter(currentRow)}`;
};

const getLinearTrackPath = (entry: PositionedEntry) =>
  getTrackPath(
    getStartOffset(entry),
    entry.endDate ? getMonthOffset(entry.endMonth + 1) : linearTimelineWidth,
    entry.row,
    entry.lanePoints.map((point) => ({
      offset: getMonthOffset(point.month),
      row: point.row,
    })),
    36,
  );

const getEvenTrackPath = (entry: PositionedEntry) => {
  const position = getEvenLanePosition(entry);

  return getTrackPath(
    getEvenEntryOffset(entry),
    entry.endDate ? getEvenEndOffset(entry) : evenTimelineWidth,
    position.row,
    position.lanePoints,
    Math.min(12, eventStep / 2),
  );
};

const linearNowOffset = getMonthOffset(layout.endMonth - 1);
const evenNowOffset = getEvenMonthOffset(layout.endMonth);
const yearTicks = layout.ticks.filter((tick) => tick.label);
---

<section
  class:list={["timeline-shell", compact && "timeline-shell-icons"]}
  aria-labelledby="timeline-title"
  data-cv-timeline
  data-timeline-spacing="linear"
>
  <div class="timeline-heading">
    <div>
      <h1
        id="timeline-title"
        class="handwritten-heading handwritten-heading--page"
      >
        Things I’ve done
      </h1>
      <p>
        {
          compact
            ? "Everything together, from the earliest start to what is active now."
            : "Everything together, from the earliest start to what is active now."
        }
      </p>
    </div>
    <div class="timeline-controls">
      <p class="scroll-note" aria-hidden="true">
        Scroll through time <ArrowRightIcon class="ui-icon" />
      </p>
      <button
        class="spacing-switch"
        type="button"
        role="switch"
        aria-checked="false"
        aria-label="Evenly space timeline entries"
        title="Evenly space timeline entries"
        data-timeline-spacing-toggle
        data-cuelume-toggle
      >
        <span class="spacing-option spacing-option-linear">Linear</span>
        <span class="spacing-track" aria-hidden="true">
          <span class="spacing-thumb"></span>
        </span>
        <span class="spacing-option spacing-option-even">Even</span>
      </button>
    </div>
  </div>

  <div class="category-legend" aria-label="Timeline categories">
    {
      TIMELINE_CATEGORIES.map((category) => (
        <span style={`--category-color:${categoryColors[category]}`}>
          <span class="legend-dot" aria-hidden="true" />
          {TIMELINE_CATEGORY_LABELS[category]}
        </span>
      ))
    }
  </div>

  <div
    class="timeline-scroller"
    data-timeline-scroller
    tabindex="0"
    role="region"
    aria-label="Horizontal life timeline, ordered from oldest to newest on a linear time scale. Scroll horizontally to explore the years."
  >
    <div
      class="timeline-canvas"
      style={`--linear-timeline-width:${linearTimelineWidth}px;--linear-time-width:${linearTimeWidth}px;--even-timeline-width:${evenTimelineWidth}px;--even-time-width:${evenTimeWidth}px;--month-width:${monthWidth}px;--content-inset:${contentInset}px;--row-height:${rowHeight}px`}
    >
      <div class="axis axis-linear" aria-hidden="true">
        <div class="axis-line"></div>
        {
          layout.ticks.map((tick) => {
            const left =
              (tick.month - layout.startMonth) * monthWidth + contentInset;
            return (
              <span
                class:list={["axis-tick", tick.label && "axis-tick-year"]}
                style={`left:${left}px`}
              >
                {tick.label && <span>{tick.label}</span>}
              </span>
            );
          })
        }
        <span class="now-axis" style={`left:${linearNowOffset}px`}>
          <span>Now</span>
        </span>
      </div>

      <div class="axis axis-even" aria-hidden="true">
        <div class="axis-line"></div>
        {
          yearTicks.map((tick) => (
            <span
              class="axis-tick axis-tick-year"
              style={`left:${getEvenMonthOffset(tick.month)}px`}
            >
              <span>{tick.label}</span>
            </span>
          ))
        }
        <span class="now-axis" style={`left:${evenNowOffset}px`}>
          <span>Now</span>
        </span>
      </div>

      <div
        class="activity activity-linear"
        aria-label="Monthly activity density"
      >
        <span class="activity-label">Busy</span>
        <div class="activity-bars" aria-hidden="true">
          {
            layout.density.map((count, index) => (
              <span
                title={`${count} active ${count === 1 ? "thing" : "things"}`}
                style={`height:${Math.max(2, (count / layout.maxDensity) * 28)}px;left:${index * monthWidth + contentInset}px`}
              />
            ))
          }
        </div>
      </div>

      <div
        class="activity activity-even"
        aria-label="Chronological start order"
      >
        <span class="activity-label">Starts</span>
        <div class="start-markers" aria-hidden="true">
          {
            layout.entries.map((entry, index) => (
              <span
                title={entry.startDate}
                style={`left:${getEvenStartOffset(index)}px`}
              />
            ))
          }
        </div>
      </div>

      <div
        class="unified-graph"
        style={`--linear-graph-height:${linearGraphHeight}px;--even-graph-height:${evenGraphHeight}px`}
      >
        <span
          class="now-marker"
          style={`--linear-left:${linearNowOffset}px;--even-left:${evenNowOffset}px`}
          aria-hidden="true"></span>

        <svg
          class="entry-tracks entry-tracks-linear"
          width={linearTimelineWidth}
          height={linearGraphHeight}
          viewBox={`0 0 ${linearTimelineWidth} ${linearGraphHeight}`}
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          {
            layout.entries
              .filter((entry) => entry.kind === "span")
              .map((entry) => (
                <path
                  d={getLinearTrackPath(entry)}
                  style={`--entry-color:${categoryColors[entry.category]}`}
                />
              ))
          }
        </svg>

        <svg
          class="entry-tracks entry-tracks-even"
          width={evenTimelineWidth}
          height={evenGraphHeight}
          viewBox={`0 0 ${evenTimelineWidth} ${evenGraphHeight}`}
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          {
            layout.entries
              .filter((entry) => entry.kind === "span")
              .map((entry) => (
                <path
                  d={getEvenTrackPath(entry)}
                  style={`--entry-color:${categoryColors[entry.category]}`}
                />
              ))
          }
        </svg>

        {
          layout.entries.map((entry) => {
            const color = categoryColors[entry.category];
            const start = getStartOffset(entry);
            const evenStart = getEvenEntryOffset(entry);
            const top = entry.row * rowHeight;
            const evenTop = getEvenLanePosition(entry).row * rowHeight;
            const labelOffset = (entry.labelRow - entry.row) * rowHeight;
            const connectorTop = nodeCenter + Math.min(0, labelOffset);
            const label = `${entry.title}, ${TIMELINE_CATEGORY_LABELS[entry.category]}, ${entry.subtitle}, ${getTimelineDateLabel(entry)}`;

            return (
              <div
                class="graph-row"
                style={`--linear-top:${top}px;--even-top:${evenTop}px`}
              >
                <span class="row-guide" aria-hidden="true" />
                <a
                  class:list={[
                    "timeline-entry",
                    `timeline-entry-${entry.kind}`,
                    entry.isCurrent && "timeline-entry-current",
                  ]}
                  href={entry.href}
                  data-start-date={entry.startDate}
                  style={`--linear-left:${start}px;--even-left:${evenStart}px;--entry-color:${color};--entry-label-offset:${labelOffset}px;--entry-connector-top:${connectorTop}px;--entry-connector-height:${Math.abs(labelOffset)}px`}
                  aria-label={label}
                  title={compact ? label : undefined}
                >
                  <span class="entry-node" aria-hidden="true">
                    {compact && (
                      <span class="compact-node-avatar">
                        <CVEntryAvatar
                          title={entry.title}
                          visual={entry.visual}
                          alt=""
                          size={22}
                          visualSize={19}
                          accent="var(--text-color)"
                        />
                      </span>
                    )}
                  </span>
                  {!compact && (
                    <>
                      {labelOffset !== 0 && (
                        <span class="entry-card-connector" aria-hidden="true" />
                      )}
                      <div class="entry-card">
                        <CVEntryAvatar
                          title={entry.title}
                          visual={entry.visual}
                          alt={`${entry.title} logo`}
                          size={25}
                          visualSize={21}
                          accent="var(--entry-color)"
                        />
                        <span class="entry-copy">
                          <span class="entry-category">
                            {TIMELINE_CATEGORY_LABELS[entry.category]}
                          </span>
                          <strong>{entry.title}</strong>
                          <span>{entry.subtitle}</span>
                          <time>{getTimelineDateLabel(entry)}</time>
                        </span>
                      </div>
                    </>
                  )}
                </a>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<script is:inline data-astro-rerun>
  (() => {
    const STORAGE_KEY = "rgo-cv-timeline-spacing";

    function getStoredSpacing() {
      try {
        const value = window.localStorage.getItem(STORAGE_KEY);
        return value === "even" ? "even" : "linear";
      } catch {
        return "linear";
      }
    }

    function applyTimelineSpacing(spacing, preserveScroll) {
      const timeline = document.querySelector("[data-cv-timeline]");
      if (!(timeline instanceof HTMLElement)) return;

      const scroller = timeline.querySelector("[data-timeline-scroller]");
      const toggle = timeline.querySelector("[data-timeline-spacing-toggle]");
      if (!(scroller instanceof HTMLElement)) return;
      if (!(toggle instanceof HTMLButtonElement)) return;

      const previousMaxScroll = scroller.scrollWidth - scroller.clientWidth;
      const scrollProgress =
        previousMaxScroll > 0 ? scroller.scrollLeft / previousMaxScroll : 0;

      timeline.dataset.timelineSpacing = spacing;
      toggle.setAttribute("aria-checked", String(spacing === "even"));
      toggle.title =
        spacing === "even"
          ? "Use linear time spacing"
          : "Evenly space timeline entries";
      scroller.setAttribute(
        "aria-label",
        spacing === "even"
          ? "Horizontal life timeline, ordered by start date with equal space between entries. Scroll horizontally to explore."
          : "Horizontal life timeline, ordered from oldest to newest on a linear time scale. Scroll horizontally to explore the years.",
      );

      requestAnimationFrame(() => {
        const nextMaxScroll = scroller.scrollWidth - scroller.clientWidth;
        scroller.scrollLeft = preserveScroll
          ? scrollProgress * Math.max(0, nextMaxScroll)
          : 0;
        scroller.dataset.timelinePositioned = "true";
      });
    }

    applyTimelineSpacing(getStoredSpacing(), false);

    if (window.__cvTimelineSpacingInitialized) return;
    window.__cvTimelineSpacingInitialized = true;

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const toggle = target.closest("[data-timeline-spacing-toggle]");
      if (!(toggle instanceof HTMLButtonElement)) return;

      const timeline = toggle.closest("[data-cv-timeline]");
      if (!(timeline instanceof HTMLElement)) return;

      const spacing =
        timeline.dataset.timelineSpacing === "even" ? "linear" : "even";

      try {
        window.localStorage.setItem(STORAGE_KEY, spacing);
      } catch {
        // The visible switch should still work if storage is unavailable.
      }

      applyTimelineSpacing(spacing, true);
    });
  })();
</script>

<style>
  .timeline-shell {
    width: min(var(--wide-width), calc(100vw - (var(--page-padding) * 2)));
    margin-left: 50%;
    transform: translateX(-50%);
  }

  .timeline-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  h1 {
    margin: 0;
    font-size: var(--font-size-handwritten-page);
    font-family: var(--font-family-handwritten);
    font-weight: 400;
    line-height: 0.95;
  }

  .timeline-heading p {
    margin: 0.2rem 0 0;
    color: var(--gray-color);
    font-size: 0.9rem;
  }

  .timeline-controls {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.75rem;
  }

  .scroll-note {
    flex: 0 0 auto;
    font-family: var(--font-family-mono);
    font-size: 0.72rem !important;
  }

  .spacing-switch {
    display: inline-flex;
    min-height: 28px;
    align-items: center;
    gap: 0.35rem;
    padding: 0.18rem 0.38rem;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: var(--bg-secondary);
    color: var(--gray-color);
    cursor: pointer;
    font-family: var(--font-family-mono);
    font-size: 0.62rem;
    line-height: 1;
    white-space: nowrap;
  }

  .spacing-switch:hover {
    border-color: color-mix(
      in srgb,
      var(--link-color) 55%,
      var(--border-color)
    );
  }

  .spacing-switch:focus-visible {
    outline: 2px solid var(--link-color);
    outline-offset: 2px;
  }

  .spacing-option {
    transition: color 0.15s ease;
  }

  .spacing-option-linear {
    color: var(--text-color);
  }

  .spacing-track {
    position: relative;
    width: 1.6rem;
    height: 0.9rem;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: var(--surface-color);
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .spacing-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 0.58rem;
    height: 0.58rem;
    border-radius: 50%;
    background: var(--link-color);
    transition: transform 0.15s ease;
  }

  .timeline-shell[data-timeline-spacing="even"] .spacing-option-linear {
    color: var(--gray-color);
  }

  .timeline-shell[data-timeline-spacing="even"] .spacing-option-even {
    color: var(--text-color);
  }

  .timeline-shell[data-timeline-spacing="even"] .spacing-track {
    border-color: color-mix(
      in srgb,
      var(--link-color) 55%,
      var(--border-color)
    );
    background: color-mix(in srgb, var(--link-color) 12%, var(--surface-color));
  }

  .timeline-shell[data-timeline-spacing="even"] .spacing-thumb {
    transform: translateX(0.66rem);
  }

  .category-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.85rem;
    margin: 0.85rem 0 0.9rem;
    color: var(--gray-color);
    font-family: var(--font-family-mono);
    font-size: 0.65rem;
  }

  .category-legend > span {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .legend-dot {
    width: 0.48rem;
    height: 0.48rem;
    border: 2px solid var(--category-color);
    border-radius: 50%;
  }

  .timeline-scroller {
    position: relative;
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-inline: contain;
    scrollbar-color: var(--gray-color) var(--bg-secondary);
    scrollbar-width: thin;
    border: 1px solid var(--border-color);
    border-radius: 0.65rem;
    background:
      linear-gradient(90deg, var(--background-color), transparent 1.4rem) left /
        2.5rem 100% no-repeat local,
      linear-gradient(-90deg, var(--background-color), transparent 1.4rem)
        right / 2.5rem 100% no-repeat local,
      var(--bg-secondary);
    box-shadow: inset 0 1px color-mix(in srgb, white 20%, transparent);
  }

  .timeline-scroller:focus-visible {
    outline: 2px solid var(--link-color);
    outline-offset: 3px;
  }

  .timeline-canvas {
    --timeline-width: var(--linear-timeline-width);
    --time-width: var(--linear-time-width);

    position: relative;
    width: var(--timeline-width);
    min-width: 100%;
    padding-top: 0.9rem;
  }

  .timeline-shell[data-timeline-spacing="even"] .timeline-canvas {
    --timeline-width: var(--even-timeline-width);
    --time-width: var(--even-time-width);
  }

  .axis {
    position: relative;
    width: var(--time-width);
    height: 44px;
    margin-bottom: 0.25rem;
    font-family: var(--font-family-mono);
  }

  .axis-even {
    display: none;
  }

  .timeline-shell[data-timeline-spacing="even"] .axis-linear,
  .timeline-shell[data-timeline-spacing="even"] .activity-linear,
  .timeline-shell[data-timeline-spacing="even"] .entry-tracks-linear {
    display: none;
  }

  .timeline-shell[data-timeline-spacing="even"] .axis-even,
  .timeline-shell[data-timeline-spacing="even"] .activity-even,
  .timeline-shell[data-timeline-spacing="even"] .entry-tracks-even {
    display: block;
  }

  .axis-line {
    position: absolute;
    top: 25px;
    left: var(--content-inset);
    right: var(--content-inset);
    height: 1px;
    background: var(--border-color);
  }

  .axis-tick {
    position: absolute;
    top: 21px;
    width: 1px;
    height: 9px;
    background: var(--border-color);
  }

  .axis-tick-year {
    top: 17px;
    height: 17px;
    background: var(--gray-color);
  }

  .axis-tick span {
    position: absolute;
    top: -18px;
    left: 0;
    color: var(--gray-color);
    font-size: 0.68rem;
    transform: translateX(-50%);
  }

  .now-axis {
    position: absolute;
    top: 17px;
