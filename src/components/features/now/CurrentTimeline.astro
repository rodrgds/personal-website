---
import CVEntryAvatar from "../cv/CVEntryAvatar.astro";
import { ArrowRightIcon } from "heroicons-svelte/24/outline";
import { getCVCollectionsData } from "../../../cv/data";
import {
  getCurrentTimelineEntries,
  getTimelineDateLabel,
  type TimelineEntry,
} from "../../../cv/timeline";

interface Props {
  entries?: TimelineEntry[];
}

const { entries: providedEntries }: Props = Astro.props;
const entries =
  providedEntries ?? getCurrentTimelineEntries(await getCVCollectionsData());
---

<div class="current-timeline">
  <ul>
    {
      entries.map((entry) => (
        <li class={`current-${entry.category}`}>
          <a href={entry.href}>
            <div class="current-card-inner">
              <CVEntryAvatar
                title={entry.title}
                visual={entry.visual}
                alt={`${entry.title} logo`}
                size={28}
                visualSize={22}
                accent="var(--current-color)"
              />
              <span class="current-copy">
                <strong>{entry.title}</strong>
                <span>{entry.subtitle}</span>
              </span>
              <span class="current-meta">
                <time>{getTimelineDateLabel(entry)}</time>
              </span>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="current-link">
    <a href="/cv"
      >Explore the full timeline <ArrowRightIcon class="ui-icon" /></a
    >
  </p>
</div>

<style>
  .current-timeline {
    margin: 0.45rem 0 1.6rem;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    --current-color: var(--flexoki-orange);
    min-width: 0;
  }

  .current-personal-projects {
    --current-color: var(--flexoki-cyan);
  }

  .current-university-projects {
    --current-color: var(--flexoki-green);
  }

  .current-education {
    --current-color: var(--flexoki-blue);
  }

  a {
    display: grid;
    min-height: 3.75rem;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.2rem;
    border-bottom: 1px solid var(--border-color);
    color: var(--text-color);
    text-decoration: none;
    transition:
      border-color 0.15s ease-out,
      color 0.15s ease-out;
  }

  .current-card-inner {
    display: contents;
  }

  a:hover,
  a:focus-visible {
    border-color: var(--current-color);
  }

  .current-copy {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    line-height: 1.2;
  }

  .current-copy strong,
  .current-copy span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .current-copy strong {
    color: var(--heading-color);
    font-size: 0.88rem;
  }

  a:hover .current-copy strong,
  a:focus-visible .current-copy strong {
    color: var(--link-color);
  }

  .current-copy span {
    margin-top: 0.18rem;
    color: var(--gray-color);
    font-size: 0.72rem;
  }

  .current-meta {
    flex: 0 0 auto;
    color: var(--gray-color);
    font-family: var(--font-family-mono);
    font-size: 0.62rem;
    line-height: 1;
    white-space: nowrap;
  }

  .current-link {
    margin: 0.55rem 0 0;
    text-align: right;
    font-size: 0.82rem;
  }

  .current-link a {
    display: inline;
    min-height: 0;
    padding: 0;
    overflow: visible;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--link-color);
    text-decoration: underline;
  }

  @media (max-width: 700px) {
    ul {
      grid-template-columns: 1fr;
    }

    a {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .current-meta {
      grid-column: 2;
      margin-top: -0.25rem;
    }
  }
</style>
